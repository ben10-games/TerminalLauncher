<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground layer: the Terminal Launcher ">_" glyph in
    the same neon green (#00FF66) used for all terminal text in the app
    itself. Drawn as two stroked, round-capped paths (a chevron and an
    underscore) rather than filled shapes, matching the attached
    reference icon's clean/minimal style.

    Sized small and centered: every point stays within ~24dp of the
    108x108 viewport's center (54,54), well inside the 66dp-diameter
    safe zone (radius 33) that's guaranteed visible on every launcher
    mask shape (circle, squircle, rounded square).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF00FF66"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M34,42 L50,54 L34,66" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF00FF66"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M48,72 L68,72" />
</vector>
